# PostgreSQL for local development. Compose reads these values.
POSTGRES_DB=service_business_cloud
POSTGRES_USER=sbc
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432

# API and web development servers
API_PORT=8002
WEB_ORIGINS=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8002

# The API/Drizzle connection string. Keep credentials out of source control.
DATABASE_URL=postgresql://sbc:local-dev-only@localhost:5432/service_business_cloud

# Security / Authentication
JWT_SECRET=dev-jwt-secret-min-32-characters-long-service-business-cloud

# Optional transition fallback. New installations set the active guest key in the platform settings UI.
# If used, generate 32 random bytes and encode as 64 hex characters.
GUEST_TOKEN_ENCRYPTION_KEY=
GUEST_TOKEN_ENCRYPTION_KEY_ID=v1

# Bootstrap-only platform setup. Keep both values outside the UI and source control.
# APP_CONFIG_MASTER_KEY wraps all system secrets stored by the platform settings UI.
APP_CONFIG_MASTER_KEY=
# A one-time token for the first authenticated platform administrator.
PLATFORM_BOOTSTRAP_TOKEN=
# Public HTTPS API origin used for provider server-to-server callbacks (set before enabling payments).
PAYMENTS_API_PUBLIC_URL=
